{
  "name": "edgedl-standalone",
  "version": "1.4.6",
  "description": "EdgeDL Standalone High-Speed Video & Audio Downloader",
  "author": "ahmedrasheed-dev",
  "license": "ISC",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "start": "vite build && electron .",
    "dev": "vite build && electron .",
    "build:vite": "vite build",
    "build": "vite build && electron-builder --win nsis",
    "build:all": "vite build && electron-builder --win nsis portable",
    "build:win": "vite build && electron-builder --win nsis",
    "build:portable": "vite build && electron-builder --win portable"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.0.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.1"
  },
  "build": {
    "appId": "com.edgedl.standalone",
    "productName": "EdgeDL Standalone",
    "publish": null,
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "EdgeDL Standalone"
    },
    "files": [
      "main.js",
      "server/**/*",
      "dist/**/*",
      "ui/**/*",
      "icon.png",
      "icon.ico",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "node_modules/ffmpeg-static",
        "to": "ffmpeg-static"
      }
    ]
  }
}
